<!-- app/views/toys/new.html.erb -->
<h1>New Toy</h1>

<%= form_with model: @toy do |form| %>
  <div>
    <%= text_field_with_label form, :name %>
  </div>

  <div>
    <%= text_field_with_label form, :price %>
  </div>

  <div>
    <%= form.label :in_stock %>
    <%= form.check_box :in_stock %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.submit "Create Toy" %>
  </div>
<% end %>
